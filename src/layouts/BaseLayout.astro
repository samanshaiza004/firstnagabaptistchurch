---
import { getImage } from "astro:assets";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ogSource from "../assets/images/bgoption2.webp";
import { getCmsContent } from "../lib/cms/content";
import { localImages } from "../lib/cms/local-images";
import type { CmsImage } from "../lib/cms/types";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  socialImage?: CmsImage;
  redirectTo?: string;
}

const { settings } = await getCmsContent();
const { title, description = settings.description, noindex = false, socialImage, redirectTo } = Astro.props;
const routePath = Astro.url.pathname.replace(/\/index\.html$/, "/").replace(/\.html$/, "");
const canonicalPath = routePath === "/" ? "/" : routePath.replace(/\/$/, "");
const canonical = new URL(canonicalPath, settings.domain);
let ogUrl: URL;
if (socialImage?.source === "sanity") {
  const url = new URL(socialImage.url);
  url.searchParams.set("w", "1200"); url.searchParams.set("h", "630"); url.searchParams.set("fit", "crop"); url.searchParams.set("auto", "format");
  ogUrl = url;
} else {
  const localSource = socialImage?.source === "local" ? localImages[socialImage.key] : ogSource;
  const ogImage = typeof localSource === "string" ? undefined : await getImage({ src: localSource, width: 1200, height: 630, fit: "cover", format: "webp" });
  ogUrl = new URL(typeof localSource === "string" ? localSource : ogImage!.src, settings.domain);
}
const structuredData = {
  "@context": "https://schema.org",
  "@type": "Church",
  name: settings.name,
  url: settings.domain,
  email: settings.email,
  telephone: settings.phoneHref,
  address: {
    "@type": "PostalAddress",
    streetAddress: settings.address,
    addressRegion: "TX",
    addressCountry: "US",
  },
};
---

<!doctype html>
<html lang="en" data-service-standard={settings.serviceTime.standard} data-service-daylight={settings.serviceTime.daylight} data-service-time-zone={settings.serviceTime.timeZone}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#243343" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {noindex && <meta name="robots" content="noindex, follow" />}
    {redirectTo && <meta http-equiv="refresh" content={`0; url=${redirectTo}`} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={settings.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />
    <title>{title}</title>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <a href="#main-content" class="fixed left-4 top-4 z-[100] -translate-y-24 rounded-md bg-background px-4 py-2 text-foreground shadow-lg transition-transform focus:translate-y-0">Skip to main content</a>
    <Header settings={settings} />
    <main id="main-content" tabindex="-1"><slot /></main>
    <Footer settings={settings} />
    <script>import "../scripts/service-time";</script>
  </body>
</html>
