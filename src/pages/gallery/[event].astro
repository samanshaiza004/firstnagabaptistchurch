---
import { ArrowLeft, Images, MapPin } from "@lucide/astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import GalleryPhotoGrid from "../../components/GalleryPhotoGrid.astro";
import { getCmsContent } from "../../lib/cms/content";
import type { GalleryEventContent, GalleryPhotoContent } from "../../lib/cms/types";

export async function getStaticPaths() {
  const { gallery } = await getCmsContent();
  const groups = new Map<string, { event: GalleryEventContent; photos: GalleryPhotoContent[] }>();
  for (const photo of gallery) {
    const group = groups.get(photo.event.id);
    if (group) group.photos.push(photo);
    else groups.set(photo.event.id, { event: photo.event, photos: [photo] });
  }
  return [...groups.values()].map((group) => ({ params: { event: group.event.id }, props: group }));
}

interface Props { event: GalleryEventContent; photos: GalleryPhotoContent[] }
const { event, photos } = Astro.props;
const { settings } = await getCmsContent();
const description = `${photos.length} photographs from ${event.title}, ${event.dateLabel}.`;
---

<BaseLayout title={`${event.title} Gallery | ${settings.name}`} description={description} socialImage={photos[0]?.image}>
  <section class="bg-primary text-primary-foreground on-dark">
    <div class="site-container py-14 md:py-20">
      <a href="/gallery" class="mb-8 inline-flex items-center gap-2 text-sm font-semibold text-cotton/75 underline hover:text-cotton"><ArrowLeft class="size-4" aria-hidden="true" />All event collections</a>
      <p class="eyebrow">Church gallery</p>
      <h1 class="max-w-3xl font-serif text-4xl font-semibold leading-[1.05] md:text-6xl">{event.title}</h1>
      <div class="mt-6 flex flex-wrap gap-x-6 gap-y-2 text-sm text-cotton/75">
        <span>{event.dateLabel}</span>
        <span class="inline-flex items-center gap-2"><MapPin class="size-4" aria-hidden="true" />{event.location}</span>
        <span class="inline-flex items-center gap-2"><Images class="size-4" aria-hidden="true" />{photos.length} {photos.length === 1 ? "photograph" : "photographs"}</span>
      </div>
    </div>
  </section>
  <hr class="band-major" aria-hidden="true" />

  <section class="section">
    <div class="site-container">
      <GalleryPhotoGrid photos={photos} />
      <div class="mt-12 border-t border-border pt-8"><a class="button button-secondary" href="/gallery"><ArrowLeft class="size-4" aria-hidden="true" />Back to all collections</a></div>
    </div>
  </section>
</BaseLayout>
