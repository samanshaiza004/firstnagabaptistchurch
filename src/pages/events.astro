---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import EventsList from "../components/EventsList.astro";
import { getCmsContent } from "../lib/cms/content";

const { pages, events } = await getCmsContent();
const page = pages.events;
---

<BaseLayout title={page.seo.title} description={page.seo.description} socialImage={page.seo.socialImage}>
  <PageHero {...page.hero} />
  <EventsList events={events} page={page} />
</BaseLayout>
