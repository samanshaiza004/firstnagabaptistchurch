---
import { BookOpen, Globe, HandHeart, Heart, House, QrCode, Quote, Shield, Smartphone, Users } from "@lucide/astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import heroImage from "../assets/images/fundraider.jpg";
import { siteConfig } from "../site-config";

const methods = [
  { name: "PayPal", description: "A familiar online payment option", contact: siteConfig.donations.paypal, image: "/paypal.jpg", color: "bg-[#0070ba]", instructions: ["Visit paypal.com or use the PayPal app", `Send payment to: ${siteConfig.donations.paypal}`, "Include ‘Donation’ in the payment notes", "Keep your payment confirmation for your records"] },
  { name: "Zelle", description: "Fast, free bank-to-bank transfers", contact: siteConfig.donations.zelle, image: "/zelle.jpg", color: "bg-[#6d1ed4]", instructions: ["Open your banking app with Zelle", `Send to phone: ${siteConfig.donations.zelle}`, "Enter your donation amount", "Complete the secure transfer"] },
];
const impactAreas = [
  { icon: BookOpen, title: "Ministry of the Word", description: "Pastoral salaries, teaching ministries, and resources that ground our church in Scripture—the primary way God transforms lives and builds His people." },
  { icon: Users, title: "Community Support", description: "Assistance for Naga families transitioning to life in the DFW area." },
  { icon: House, title: "Facility & Operations", description: "Maintaining our worship space and covering operational expenses." },
  { icon: Globe, title: "Worship & Media", description: "Audio-visual, livestream, website, printed media, and creative resources that help our community encounter God and stay connected." },
  { icon: Heart, title: "Youth & Children", description: "Age-appropriate teaching, events, safe environments, and mentorship helping young people grow in faith and character." },
  { icon: HandHeart, title: "Benevolence Fund", description: "Helping members and community in times of need and hardship." },
];
---

<BaseLayout title="Give | First Naga Baptist Church" description="Support the ministries and community outreach of First Naga Baptist Church.">
  <PageHero eyebrow="Giving as Worship" title="Support Our Ministry" description="Your generous giving helps us spread the Gospel, support Naga families, and build bridges between communities in DFW and beyond." image={heroImage} imageAlt="First Naga Baptist Church community fundraiser" />

  <section class="section"><div class="site-container"><div class="mb-12 text-center"><p class="eyebrow">Ways to Give</p><h2 class="section-title mb-4">Choose Your Donation Method</h2><p class="section-copy mx-auto">Scan the QR code with your phone camera or payment app, then verify the church recipient before sending.</p></div><div class="mx-auto mb-12 grid max-w-4xl gap-8 md:grid-cols-2">{methods.map((method) => <article class="card overflow-hidden border-2"><header class:list={["p-6 text-white", method.color]}><div class="flex items-center gap-3"><QrCode class="size-6" /><div><h3 class="text-xl font-semibold">{method.name}</h3><p class="text-sm text-white/80">{method.description}</p></div></div></header><div class="p-6"><div class="mb-6 rounded-lg bg-accent/40 p-4 text-center"><p class="font-semibold">{method.name} Contact:</p><p class="break-all font-mono text-lg text-primary">{method.contact}</p></div><div class="mx-auto mb-6 w-fit rounded-xl bg-white p-4 shadow-inner"><img src={method.image} width="192" height="192" alt={`${method.name} donation QR code`} loading="lazy" decoding="async" class="size-48 object-contain" /></div><h4 class="mb-3 flex items-center gap-2 font-semibold"><Smartphone class="size-4 text-primary" />How to Donate</h4><ol class="space-y-2">{method.instructions.map((instruction, index) => <li class="flex gap-3 text-sm text-muted-foreground"><span class="flex size-5 shrink-0 items-center justify-center rounded-full bg-primary/10 text-xs font-medium text-primary">{index + 1}</span>{instruction}</li>)}</ol></div></article>)}</div><div class="flex items-center justify-center gap-3 text-sm text-muted-foreground"><Shield class="size-5 text-green-700" /><p>Always verify the church recipient before completing a donation.</p></div></div></section>

  <section class="section bg-accent/30"><div class="site-container"><div class="mx-auto mb-12 max-w-3xl text-center"><p class="eyebrow text-secondary-foreground">Your Impact</p><h2 class="section-title mb-4">Where Your Giving Goes</h2><p class="section-copy mx-auto">Every donation directly supports our church's mission and makes a tangible difference in our community.</p></div><div class="mx-auto grid max-w-5xl gap-6 sm:grid-cols-2 lg:grid-cols-3">{impactAreas.map((area) => { const Icon = area.icon; return <article class="card flex gap-4 p-5"><span class="flex size-12 shrink-0 items-center justify-center rounded-full bg-primary/10"><Icon class="size-6 text-primary" /></span><div><h3 class="mb-1 font-semibold">{area.title}</h3><p class="text-sm text-muted-foreground">{area.description}</p></div></article>; })}</div></div></section>

  <section class="section bg-primary text-primary-foreground"><div class="site-container"><div class="mx-auto max-w-3xl text-center"><Quote class="mx-auto mb-6 size-12 text-secondary" /><blockquote class="mb-6 font-serif text-2xl italic leading-relaxed md:text-3xl">“Each of you should give what you have decided in your heart to give, not reluctantly or under compulsion, for God loves a cheerful giver.”</blockquote><cite class="text-lg text-primary-foreground/80">— 2 Corinthians 9:7</cite><div class="mt-12 border-t border-primary-foreground/20 pt-8"><h2 class="mb-4 font-serif text-xl font-semibold">Thank You for Your Generosity</h2><p class="mx-auto max-w-xl leading-relaxed text-primary-foreground/80">On behalf of First Naga Baptist Church, we extend our heartfelt gratitude for your faithful giving. Your contributions help us fulfill our God-given mission and touch lives both near and far.</p></div></div></div></section>
</BaseLayout>
