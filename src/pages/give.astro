---
import { BookOpen, Globe, HandHeart, Heart, House, QrCode, Quote, Shield, Smartphone, Users } from "@lucide/astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import CmsImage from "../components/CmsImage.astro";
import PageHero from "../components/PageHero.astro";
import { getCmsContent } from "../lib/cms/content";

const { pages, givingMethods, impactAreas } = await getCmsContent();
const page = pages.giving;
const icons = { book: BookOpen, users: Users, house: House, globe: Globe, heart: Heart, service: HandHeart, connection: HandHeart };
---

<BaseLayout title={page.seo.title} description={page.seo.description} socialImage={page.seo.socialImage}>
  <PageHero {...page.hero} />

  <section class="section"><div class="site-container"><div class="mb-12 text-center"><p class="eyebrow">{page.waysEyebrow}</p><h2 class="section-title mb-4">{page.waysTitle}</h2><p class="section-copy mx-auto">{page.waysDescription}</p></div><div class="mx-auto mb-12 grid max-w-4xl gap-8 md:grid-cols-2">{givingMethods.map((method) => <article class="card overflow-hidden border-2"><header class="p-6 text-white" style={`background-color:${method.brandColor}`}><div class="flex items-center gap-3"><QrCode class="size-6" /><div><h3 class="text-xl font-semibold">{method.name}</h3><p class="text-sm text-white/80">{method.description}</p></div></div></header><div class="p-6"><div class="mb-6 rounded-lg bg-accent/40 p-4 text-center"><p class="font-semibold">{method.name} Contact:</p><p class="break-all font-mono text-lg text-primary">{method.contact}</p></div><div class="mx-auto mb-6 w-fit rounded-xl bg-white p-4 shadow-inner"><CmsImage image={method.qrCode} widths={[192, 384]} sizes="192px" loading="lazy" class="size-48 object-contain" /></div><h4 class="mb-3 flex items-center gap-2 font-semibold"><Smartphone class="size-4 text-primary" />How to Donate</h4><ol class="space-y-2">{method.instructions.map((instruction, index) => <li class="flex gap-3 text-sm text-muted-foreground"><span class="flex size-5 shrink-0 items-center justify-center rounded-full bg-primary/10 text-xs font-medium text-primary">{index + 1}</span>{instruction}</li>)}</ol></div></article>)}</div><div class="flex items-center justify-center gap-3 text-sm text-muted-foreground"><Shield class="size-5 text-green-700" /><p>{page.verificationNotice}</p></div></div></section>

  <section class="section bg-accent/30"><div class="site-container"><div class="mx-auto mb-12 max-w-3xl text-center"><p class="eyebrow text-secondary-foreground">{page.impactEyebrow}</p><h2 class="section-title mb-4">{page.impactTitle}</h2><p class="section-copy mx-auto">{page.impactDescription}</p></div><div class="mx-auto grid max-w-5xl gap-6 sm:grid-cols-2 lg:grid-cols-3">{impactAreas.map((area) => { const Icon = icons[area.icon]; return <article class="card flex gap-4 p-5"><span class="flex size-12 shrink-0 items-center justify-center rounded-full bg-primary/10"><Icon class="size-6 text-primary" /></span><div><h3 class="mb-1 font-semibold">{area.title}</h3><p class="text-sm text-muted-foreground">{area.description}</p></div></article>; })}</div></div></section>

  <section class="section bg-primary text-primary-foreground"><div class="site-container"><div class="mx-auto max-w-3xl text-center"><Quote class="mx-auto mb-6 size-12 text-secondary" /><blockquote class="mb-6 font-serif text-2xl italic leading-relaxed md:text-3xl">“{page.scripture}”</blockquote><cite class="text-lg text-primary-foreground/80">— {page.scriptureCitation}</cite><div class="mt-12 border-t border-primary-foreground/20 pt-8"><h2 class="mb-4 font-serif text-xl font-semibold">{page.thanksTitle}</h2><p class="mx-auto max-w-xl leading-relaxed text-primary-foreground/80">{page.thanksDescription}</p></div></div></div></section>
</BaseLayout>
