---
import { BookOpen, Globe, HandHeart, Heart, House, QrCode, ShieldCheck, Smartphone, Users } from "@lucide/astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import CmsImage from "../components/CmsImage.astro";
import PageHero from "../components/PageHero.astro";
import { getCmsContent } from "../lib/cms/content";

const { pages, givingMethods, impactAreas } = await getCmsContent();
const page = pages.giving;
const icons = { book: BookOpen, users: Users, house: House, globe: Globe, heart: Heart, service: HandHeart, connection: HandHeart };
---

<BaseLayout title={page.seo.title} description={page.seo.description} socialImage={page.seo.socialImage}>
  <PageHero {...page.hero} />

  <section class="section"><div class="site-container"><div class="mb-12 text-center"><p class="eyebrow">{page.waysEyebrow}</p><h2 class="section-title mb-4">{page.waysTitle}</h2><p class="section-copy mx-auto">{page.waysDescription}</p></div><div class="mx-auto grid max-w-4xl gap-8 md:grid-cols-2">{givingMethods.map((method) => <article class="card overflow-hidden"><header class="p-6 text-white" style={`background-color:${method.brandColor}`}><div class="flex items-center gap-3"><QrCode class="size-6" aria-hidden="true" /><div><h3 class="text-xl font-semibold">{method.name}</h3><p class="text-sm text-white/80">{method.description}</p></div></div></header><div class="p-6"><div class="mb-6 rounded-md border border-oxblood/30 bg-oxblood/8 p-4 text-center"><p class="font-semibold">{method.name} recipient</p><p class="break-all font-mono text-lg text-primary">{method.contact}</p></div><div class="mx-auto mb-6 w-fit rounded-md border border-border bg-white p-4"><CmsImage image={method.qrCode} widths={[192, 384]} sizes="192px" loading="lazy" class="size-48 object-contain" /></div><div class="mb-6 flex gap-3 border-l-2 border-oxblood bg-muted/50 p-4 text-sm"><ShieldCheck class="mt-0.5 size-5 shrink-0 text-oxblood" aria-hidden="true" /><p>{page.verificationNotice} Confirm that the recipient shown above matches before sending.</p></div><h4 class="mb-3 flex items-center gap-2 font-semibold"><Smartphone class="size-4 text-primary" aria-hidden="true" />How to donate</h4><ol class="space-y-2">{method.instructions.map((instruction, index) => <li class="flex gap-3 text-sm text-muted-foreground"><span class="flex size-5 shrink-0 items-center justify-center bg-primary/10 text-xs font-medium text-primary">{index + 1}</span>{instruction}</li>)}</ol></div></article>)}</div></div></section>

  <section class="section bg-muted/40"><div class="site-container"><div class="mx-auto mb-12 max-w-3xl text-center"><p class="eyebrow">{page.impactEyebrow}</p><h2 class="section-title mb-4">{page.impactTitle}</h2><p class="section-copy mx-auto">{page.impactDescription}</p></div><div class="mx-auto grid max-w-5xl gap-6 sm:grid-cols-2 lg:grid-cols-3">{impactAreas.map((area) => { const Icon = icons[area.icon]; return <article class="card flex gap-4 p-5"><span class="flex size-12 shrink-0 items-center justify-center rounded-md bg-primary/10"><Icon class="size-6 text-primary" /></span><div><h3 class="mb-1 font-semibold">{area.title}</h3><p class="text-sm text-muted-foreground">{area.description}</p></div></article>; })}</div></div></section>

  <section class="section bg-primary text-primary-foreground on-dark"><div class="site-container"><div class="mx-auto max-w-3xl"><blockquote class="quote-scripture mb-6 text-2xl leading-relaxed text-cotton md:text-3xl">“{page.scripture}”<cite class="block text-lg text-cotton/80">— {page.scriptureCitation}</cite></blockquote><div class="mt-12 border-t border-cotton/20 pt-8 text-center"><h2 class="font-serif text-2xl font-semibold">Thank you for supporting the ministry of FNBC.</h2></div></div></div></section>
</BaseLayout>
