---
import { ArrowLeft, ArrowRight, Calendar, Clock, MapPin } from "@lucide/astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import CmsImage from "../components/CmsImage.astro";
import RichText from "../components/RichText.astro";
import { getCmsContent } from "../lib/cms/content";
import { isPublicFacingEvent, splitEventsByDate } from "../lib/events";

const { settings, pages, events: allEvents, people, gallery } = await getCmsContent();
const page = pages.home;
const { upcoming } = splitEventsByDate(allEvents.filter(isPublicFacingEvent));
const nextEvents = upcoming.slice(0, 3);

const pastor = people.filter((person) => person.group === "leadership").sort((a, b) => a.order - b.order)[0];
const featuredPhotos = gallery.filter((photo) => photo.image).sort((a, b) => b.order - a.order).slice(0, 5);
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(`${settings.venue}, ${settings.address}`)}`;

const titleParts = page.hero.title.split(/(?=Baptist Church)/);
const timeMarkup = (event: (typeof nextEvents)[number]) =>
  event.timeKind === "seasonal" ? "seasonal" : event.timeLabel;
---

<BaseLayout title={page.seo.title} description={page.seo.description} socialImage={page.seo.socialImage}>
  <!-- 1. Hero: identity, current Sunday time, Plan a Visit / Our Story -->
  <section class="home-hero on-dark">
    <div class="home-hero-grid">
      <div class="home-hero-copy">
        <p class="eyebrow">{page.hero.eyebrow}</p>
        <h1 class="home-hero-title">{titleParts[0]}{titleParts[1] && <em>{titleParts[1]}</em>}</h1>
        <p class="home-hero-copy-text">{page.hero.description}</p>
        <p class="mt-6 flex items-center gap-2 text-cotton/90"><Clock class="size-5 text-cotton/70" aria-hidden="true" /><span class="font-semibold">Sundays at <span data-service-time>{settings.serviceTime.standard} standard / {settings.serviceTime.daylight} daylight time</span></span></p>
        <div class="mt-8 flex flex-col gap-4 sm:flex-row">
          <a class="button on-dark" href={page.primaryCta.href}>{page.primaryCta.label}</a>
          <a class="button button-outline on-dark" href={page.secondaryCta.href}>{page.secondaryCta.label}</a>
        </div>
      </div>
      <div class="home-hero-media">
        <CmsImage image={page.hero.image} widths={[640, 960, 1280, 1920]} sizes="(min-width: 768px) 58vw, 100vw" loading="eager" fetchpriority="high" class="size-full object-cover" />
        <p class="home-hero-note">{page.heroNote}</p>
      </div>
    </div>
  </section>

  <!-- Major band transition: hero -> Sunday essentials -->
  <hr class="band-major" aria-hidden="true" />

  <!-- 2. Sunday essentials -->
  <section class="section" aria-labelledby="service-title">
    <div class="site-container">
      <div class="section-heading-grid mb-12">
        <div><p class="eyebrow">{page.serviceEyebrow}</p><h2 id="service-title" class="section-title">{page.serviceTitle}</h2></div>
        <p class="section-copy">{page.serviceDescription}</p>
      </div>
      <div class="service-grid grid gap-6 md:grid-cols-3">
        <article class="card p-6">
          <span class="mb-4 flex size-14 items-center justify-center rounded-md bg-primary/10"><Clock class="size-6 text-primary" /></span>
          <h3 class="mb-2 font-serif text-xl font-semibold">Sunday Worship</h3>
          <p class="mb-2 text-lg font-semibold"><span data-service-time>{settings.serviceTime.standard} standard / {settings.serviceTime.daylight} daylight time</span></p>
          <p class="text-sm text-muted-foreground">Join us for our main worship service with praise, prayer, and teaching.</p>
        </article>
        <article class="card p-6">
          <span class="mb-4 flex size-14 items-center justify-center rounded-md bg-primary/10"><MapPin class="size-6 text-primary" /></span>
          <h3 class="mb-2 font-serif text-xl font-semibold">Location</h3>
          <p class="mb-2 text-lg font-semibold">{settings.venue}</p>
          <p class="text-sm text-muted-foreground">{settings.address}</p>
          <a class="mt-4 inline-flex items-center gap-1 font-semibold text-primary underline" href={directionsUrl} target="_blank" rel="noopener">Get directions <ArrowRight class="size-4" aria-hidden="true" /></a>
        </article>
        <article class="card p-6">
          <span class="mb-4 flex size-14 items-center justify-center rounded-md bg-primary/10"><Calendar class="size-6 text-primary" /></span>
          <h3 class="mb-2 font-serif text-xl font-semibold">Fellowship</h3>
          <p class="mb-2 text-lg font-semibold">After Service</p>
          <p class="text-sm text-muted-foreground">Stay for refreshments and fellowship with the community after worship.</p>
        </article>
      </div>
      <p class="mx-auto mt-8 max-w-3xl rounded-md bg-muted/60 px-4 py-3 text-center text-sm text-muted-foreground"><strong>Seasonal schedule:</strong> {page.seasonalNote}</p>
    </div>
  </section>

  <!-- 3. Next gatherings (dated, future-first) -->
  <section class="section bg-primary text-primary-foreground on-dark" aria-labelledby="gatherings-title">
    <div class="site-container">
      <div class="mb-12 flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
        <div><p class="eyebrow">{page.eventsEyebrow}</p><h2 id="gatherings-title" class="font-serif text-3xl font-bold md:text-4xl">Next Gatherings</h2></div>
        <a class="button button-outline w-fit" href={page.eventsCta.href}>{page.eventsCta.label} <ArrowRight class="size-4" /></a>
      </div>
      {nextEvents.length > 0 ? (
        <div class="grid gap-6 md:grid-cols-3">
          {nextEvents.map((event) => (
            <article class="rounded-md border border-cotton/20 bg-cotton/10 p-6">
              <div class="mb-3 flex items-center gap-2 text-cotton/85"><Calendar class="size-4" aria-hidden="true" /><span class="text-sm font-medium">{event.dateLabel}{timeMarkup(event) ? ` · ${timeMarkup(event)}` : ""}</span></div>
              <h3 class="mb-2 font-serif text-xl font-semibold">{event.title}</h3>
              <p class="text-sm leading-relaxed text-cotton/80">{event.description}</p>
            </article>
          ))}
        </div>
      ) : (
        <p class="max-w-2xl text-cotton/80">New events are announced regularly. Join us any Sunday, or check the events page for the latest schedule.</p>
      )}
    </div>
  </section>

  <!-- 4. Who we are: condensed mission -->
  <section class="section" aria-labelledby="mission-title">
    <div class="site-container grid items-center gap-12 lg:grid-cols-2">
      <div>
        <p class="eyebrow">{page.objectivesEyebrow}</p>
        <h2 id="mission-title" class="section-title mb-6">A church for the Naga family in DFW</h2>
        <p class="section-copy mb-4">First Naga Baptist Church exists to share the Word, support Naga students and families across the Dallas–Fort Worth area, and connect Naga and American churches in fellowship and mission.</p>
        <p class="section-copy mb-8">As the first Naga church established in America, we gather scattered believers into one body for worship, discipleship, and outreach.</p>
        <a class="button button-secondary" href="/about">Our mission and story <ArrowRight class="size-4" /></a>
      </div>
      <div class="relative"><CmsImage image={page.storyImage} widths={[480, 720, 960]} sizes="(min-width: 1024px) 50vw, 100vw" loading="lazy" class="story-image aspect-[4/3] w-full object-cover" /></div>
    </div>
  </section>

  <!-- 5. Community proof: a small, manual photo sequence -->
  {featuredPhotos.length > 0 && (
    <section class="section bg-muted/40" aria-labelledby="community-title">
      <div class="site-container grid items-center gap-12 lg:grid-cols-2">
        <div class="order-2 lg:order-1">
          <manner-carousel class="home-community-carousel" aria-label="Snapshots of life together" data-loop>
            <div data-slides>
              {featuredPhotos.map((photo, index) => (
                <figure data-slide aria-label={`${photo.event.title}: ${photo.title}`} hidden={index !== 0}>
                  <CmsImage image={photo.image} widths={[480, 720, 960]} sizes="(min-width: 1024px) 50vw, 100vw" loading="lazy" class="story-image aspect-[4/3] w-full object-cover" />
                  <figcaption class="mt-3 text-sm text-muted-foreground">{photo.caption}</figcaption>
                </figure>
              ))}
            </div>
            <div class="home-community-controls" aria-label="Photo controls">
              <button type="button" data-previous aria-label="View previous community photo"><ArrowLeft class="size-4" aria-hidden="true" />Previous</button>
              <button type="button" data-next aria-label="View next community photo">Next<ArrowRight class="size-4" aria-hidden="true" /></button>
            </div>
          </manner-carousel>
        </div>
        <div class="order-1 lg:order-2">
          <p class="eyebrow">Our Community</p>
          <h2 id="community-title" class="section-title mb-6">Life together</h2>
          <p class="section-copy mb-8">A living record of worship, fellowship, and the people who make this church home.</p>
          <a class="button button-secondary" href="/gallery">Visit the gallery <ArrowRight class="size-4" /></a>
        </div>
      </div>
    </section>
  )}

  <!-- 6. Leadership introduction -->
  <section class="section" aria-labelledby="leadership-intro-title">
    <div class="site-container grid items-center gap-12 lg:grid-cols-2">
      <div>
        <p class="eyebrow">Our Leadership</p>
        <h2 id="leadership-intro-title" class="section-title mb-6">Shepherded by faithful servants</h2>
        <p class="section-copy mb-4">{page.leadershipDescription}</p>
        {pastor && <p class="section-copy mb-8"><strong class="text-foreground">{pastor.name}</strong> serves as our {pastor.role.toLowerCase()}, leading worship, teaching, and pastoral care.</p>}
        <a class="button button-secondary" href="/leadership">Meet all our leaders <ArrowRight class="size-4" /></a>
      </div>
      {pastor && (
        <div class="relative mx-auto w-full max-w-sm"><CmsImage image={pastor.image} widths={[320, 480, 640]} sizes="(min-width: 1024px) 30vw, 100vw" loading="lazy" class="story-image aspect-[3/4] w-full object-cover" /></div>
      )}
    </div>
  </section>

  <!-- 7. Short history distinction -->
  <section class="section bg-muted/40" aria-labelledby="story-title">
    <div class="site-container max-w-3xl">
      <p class="eyebrow">{page.storyEyebrow}</p>
      <h2 id="story-title" class="section-title mb-6">{page.storyTitle}</h2>
      <RichText value={page.storyBody.slice(0, 1)} class="space-y-4 leading-relaxed text-muted-foreground" />
      <a class="button mt-8" href={page.storyCta.href}>{page.storyCta.label}</a>
    </div>
  </section>

  <!-- 8. Final visit invitation -->
  <section class="section bg-primary text-primary-foreground on-dark" aria-labelledby="visit-cta-title">
    <div class="site-container text-center">
      <h2 id="visit-cta-title" class="section-title mx-auto mb-4 text-cotton">We would love to meet you</h2>
      <p class="section-copy mx-auto mb-8 text-cotton/80">Join us this Sunday at <span data-service-time>{settings.serviceTime.standard} standard / {settings.serviceTime.daylight} daylight time</span>. Come as you are — there is a place for you here.</p>
      <a class="button on-dark" href="/visit">Plan your visit <ArrowRight class="size-4" /></a>
    </div>
  </section>
</BaseLayout>

<script>
  import "mannerhtml";
</script>

<style>
  .home-community-carousel { display: block; }
  .home-community-carousel [data-slides] { min-height: 0; }
  .home-community-carousel figure { margin: 0; }
  .home-community-carousel figure[hidden] { display: none; }
  .home-community-controls { display: flex; justify-content: space-between; gap: .75rem; margin-top: 1rem; }
  .home-community-controls button { display: inline-flex; align-items: center; gap: .5rem; border: 1px solid var(--color-border); padding: .62rem .8rem; background: var(--color-card); color: var(--color-ink); font-size: .75rem; font-weight: 720; letter-spacing: .06em; text-transform: uppercase; }
  .home-community-controls button:hover, .home-community-controls button:focus-visible { border-color: var(--color-indigo); background: var(--color-indigo); color: var(--color-cotton); }
</style>
