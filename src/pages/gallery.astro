---
import { ArrowRight, Images, MapPin } from "@lucide/astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import CmsImage from "../components/CmsImage.astro";
import PageHero from "../components/PageHero.astro";
import { getCmsContent } from "../lib/cms/content";

const { settings, pages, gallery } = await getCmsContent();
const page = pages.gallery;
const eventMap = new Map<string, { event: (typeof gallery)[number]["event"]; photos: typeof gallery; firstOrder: number }>();

for (const photo of [...gallery].sort((a, b) => a.order - b.order)) {
  const collection = eventMap.get(photo.event.id);
  if (collection) collection.photos.push(photo);
  else eventMap.set(photo.event.id, { event: photo.event, photos: [photo], firstOrder: photo.order });
}

const collections = [...eventMap.values()].sort((a, b) => b.firstOrder - a.firstOrder);
---

<BaseLayout title={page.seo.title} description={page.seo.description} socialImage={page.seo.socialImage}>
  <PageHero {...page.hero} />

  <section class="section" aria-labelledby="gallery-title">
    <div class="site-container">
      <header class="section-heading-grid mb-12">
        <div><p class="eyebrow">{page.introEyebrow}</p><h2 id="gallery-title" class="section-title">Event collections</h2></div>
        <div><p class="section-copy">{page.introDescription}</p><p class="mt-4 inline-flex items-center gap-2 text-sm font-semibold"><Images class="size-4 text-oxblood" aria-hidden="true" />{gallery.length} photographs across {collections.length} collections</p></div>
      </header>

      <div class="grid gap-6 md:grid-cols-2">
        {collections.map((collection, index) => (
          <a href={`/gallery/${collection.event.id}`} class:list={["gallery-collection group", index === 0 && "md:col-span-2"]}>
            <div class:list={["overflow-hidden bg-muted", index === 0 ? "aspect-[16/8]" : "aspect-[4/3]"]}>
              <CmsImage image={collection.photos[0].image} widths={[480, 720, 960, 1440]} sizes={index === 0 ? "100vw" : "(min-width: 768px) 50vw, 100vw"} loading={index < 2 ? "eager" : "lazy"} class="size-full object-cover transition-transform duration-200 group-hover:scale-[1.015]" />
            </div>
            <div class="grid gap-4 border border-t-0 border-border bg-card p-5 sm:grid-cols-[1fr_auto] sm:items-end">
              <div>
                <p class="text-xs font-bold uppercase tracking-[.13em] text-oxblood">{collection.event.dateLabel}</p>
                <h3 class="mt-1 font-serif text-2xl font-semibold leading-tight">{collection.event.title}</h3>
                <p class="mt-2 flex items-center gap-2 text-sm text-muted-foreground"><MapPin class="size-4" aria-hidden="true" />{collection.event.location}</p>
              </div>
              <span class="inline-flex items-center gap-2 text-sm font-semibold text-primary">{collection.photos.length} {collection.photos.length === 1 ? "photo" : "photos"}<ArrowRight class="size-4 transition-transform group-hover:translate-x-1" aria-hidden="true" /></span>
            </div>
          </a>
        ))}
      </div>

      <aside class="mt-16 grid items-center gap-6 border-t-[6px] border-primary bg-card p-7 md:grid-cols-[1fr_1fr_auto]" aria-labelledby="share-photos-title">
        <div><p class="eyebrow">{page.shareEyebrow}</p><h2 id="share-photos-title" class="font-serif text-3xl font-semibold">{page.shareTitle}</h2></div>
        <p class="text-muted-foreground">{page.shareDescription}</p>
        <a class="button w-fit" href={`mailto:${settings.email}?subject=Church%20gallery%20photos`}>{page.shareButtonLabel}</a>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .gallery-collection { display: block; color: inherit; text-decoration: none; }
  .gallery-collection:hover h3 { text-decoration: underline; text-decoration-color: var(--color-oxblood); text-decoration-thickness: 2px; text-underline-offset: .18em; }
</style>
