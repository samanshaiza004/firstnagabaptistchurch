---
import { getImage } from "astro:assets";
import { ChevronLeft, ChevronRight, Expand, Images, X } from "@lucide/astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import CmsImage from "../components/CmsImage.astro";
import PageHero from "../components/PageHero.astro";
import { getCmsContent } from "../lib/cms/content";
import { sanityImageUrl } from "../lib/cms/image-url";
import { localImages } from "../lib/cms/local-images";

const { settings, pages, gallery } = await getCmsContent();
const page = pages.gallery;
const photos = await Promise.all(gallery.sort((a, b) => a.order - b.order).map(async (photo, index) => {
  if (photo.image.source === "sanity") return { ...photo, expandedSrc: sanityImageUrl(photo.image, 1800, 88), position: index + 1 };
  const local = localImages[photo.image.key];
  if (!local) throw new Error(`Missing gallery image: ${photo.image.key}`);
  if (typeof local === "string") return { ...photo, expandedSrc: local, position: index + 1 };
  const expanded = await getImage({ src: local, width: Math.min(local.width, 1800), format: "webp", quality: 88 });
  return { ...photo, expandedSrc: expanded.src, position: index + 1 };
}));
const galleryEvents = [...new Map(photos.map((photo) => [photo.event.id, photo.event])).values()].sort((a, b) => a.title.localeCompare(b.title));
const photoCountByEvent = new Map(galleryEvents.map((event) => [event.id, photos.filter((photo) => photo.event.id === event.id).length]));
---

<BaseLayout title={page.seo.title} description={page.seo.description} socialImage={page.seo.socialImage}>
  <PageHero {...page.hero} />

  <main class="gallery-section section" aria-labelledby="gallery-title">
    <div class="site-container">
      <header class="gallery-intro">
        <div>
          <p class="eyebrow">{page.introEyebrow}</p>
          <h2 id="gallery-title" class="section-title">{page.introTitle}</h2>
        </div>
        <div class="gallery-intro-copy">
          <p>{page.introDescription}</p>
          <p class="gallery-count"><Images class="size-4" aria-hidden="true" />{photos.length} photographs in this collection</p>
        </div>
      </header>

      <div class="gallery-filters" role="group" aria-labelledby="gallery-filters-title">
        <h3 id="gallery-filters-title" class="gallery-filters-title">Browse by event</h3>
        <div class="gallery-filter-buttons">
          <button type="button" class="gallery-filter-button is-active" data-gallery-filter="all" aria-pressed="true" aria-controls="gallery-grid">All photos<span class="gallery-filter-count">{photos.length}</span></button>
          {galleryEvents.map((event) => (
            <button type="button" class="gallery-filter-button" data-gallery-filter={event.id} aria-pressed="false" aria-controls="gallery-grid">{event.title}<span class="gallery-filter-count">{photoCountByEvent.get(event.id) ?? 0}</span></button>
          ))}
        </div>
        <p class="gallery-result-count" data-gallery-result-count>Showing all {photos.length} photographs</p>
        <p class="gallery-empty" data-gallery-empty hidden>No photographs match this event.</p>
      </div>

      <div class="gallery-masonry" id="gallery-grid" aria-label="Church photo gallery">
        {photos.map((photo, index) => (
          <figure class="gallery-item" data-gallery-photo data-gallery-event={photo.event.id}>
            <button
              type="button"
              class="gallery-trigger"
              data-gallery-index={index}
              data-full-src={photo.expandedSrc}
              data-alt={photo.image.alt}
              data-title={photo.title}
              data-caption={photo.caption}
              data-event={photo.event.title}
              data-date={photo.event.dateLabel}
              aria-label={`View ${photo.title} in full`}
            >
              <CmsImage image={photo.image} widths={[360, 540, 720]} sizes="(min-width: 1100px) 28vw, (min-width: 640px) 44vw, 100vw" loading={index < 2 ? "eager" : "lazy"} class="gallery-photo" />
              <span class="gallery-view"><Expand class="size-4" aria-hidden="true" />View photo</span>
            </button>
            <figcaption>
              <p>{photo.event.title}<span aria-hidden="true"> · </span>{photo.event.dateLabel}</p>
              <h3>{photo.title}</h3>
            </figcaption>
          </figure>
        ))}
      </div>

      <aside class="gallery-contribute" aria-labelledby="share-photos-title">
        <div><p class="eyebrow">{page.shareEyebrow}</p><h2 id="share-photos-title">{page.shareTitle}</h2></div>
        <p>{page.shareDescription}</p>
        <a class="button" href={`mailto:${settings.email}?subject=Church%20gallery%20photos`}>{page.shareButtonLabel}</a>
      </aside>
    </div>
  </main>

  <dialog id="gallery-lightbox" class="gallery-lightbox" aria-labelledby="lightbox-title">
    <div class="lightbox-frame">
      <button type="button" class="lightbox-close" data-lightbox-close aria-label="Close expanded photo"><X class="size-6" aria-hidden="true" /></button>
      <button type="button" class="lightbox-nav lightbox-prev" data-lightbox-prev aria-label="View previous photo"><ChevronLeft class="size-7" aria-hidden="true" /></button>
      <figure class="lightbox-figure">
        <div class="lightbox-image-wrap"><img data-lightbox-image alt="" /></div>
        <figcaption>
          <div class="lightbox-kicker"><span data-lightbox-event></span><span data-lightbox-date></span><span data-lightbox-position></span></div>
          <h2 id="lightbox-title" data-lightbox-title></h2>
          <p data-lightbox-caption></p>
        </figcaption>
      </figure>
      <button type="button" class="lightbox-nav lightbox-next" data-lightbox-next aria-label="View next photo"><ChevronRight class="size-7" aria-hidden="true" /></button>
    </div>
  </dialog>
</BaseLayout>

<script>
  const dialog = document.querySelector<HTMLDialogElement>("#gallery-lightbox");
  const grid = document.querySelector<HTMLElement>("#gallery-grid");
  const items = [...document.querySelectorAll<HTMLElement>("[data-gallery-photo]")];
  const filterButtons = [...document.querySelectorAll<HTMLButtonElement>("[data-gallery-filter]")];
  const resultCount = document.querySelector<HTMLElement>("[data-gallery-result-count]");
  const emptyMessage = document.querySelector<HTMLElement>("[data-gallery-empty]");
  const image = dialog?.querySelector<HTMLImageElement>("[data-lightbox-image]");
  const title = dialog?.querySelector<HTMLElement>("[data-lightbox-title]");
  const caption = dialog?.querySelector<HTMLElement>("[data-lightbox-caption]");
  const eventName = dialog?.querySelector<HTMLElement>("[data-lightbox-event]");
  const date = dialog?.querySelector<HTMLElement>("[data-lightbox-date]");
  const position = dialog?.querySelector<HTMLElement>("[data-lightbox-position]");
  let activeEvent: string | null = null;
  let currentTriggers: HTMLButtonElement[] = [];
  let currentIndex = 0;
  let opener: HTMLButtonElement | undefined;

  const eventForItem = (item: HTMLElement) => item.dataset.galleryEvent ?? "";

  const refreshFilter = () => {
    currentTriggers = items
      .filter((item) => activeEvent === null || eventForItem(item) === activeEvent)
      .flatMap((item) => [...item.querySelectorAll<HTMLButtonElement>("[data-gallery-index]")]);
    items.forEach((item) => {
      item.hidden = activeEvent !== null && eventForItem(item) !== activeEvent;
    });
    filterButtons.forEach((button) => {
      const isPressed = activeEvent === null ? button.dataset.galleryFilter === "all" : button.dataset.galleryFilter === activeEvent;
      button.classList.toggle("is-active", isPressed);
      button.setAttribute("aria-pressed", String(isPressed));
    });
    if (resultCount) {
      resultCount.textContent = activeEvent === null
        ? `Showing all ${currentTriggers.length} photographs`
        : `Showing ${currentTriggers.length} of ${items.length} photographs`;
    }
    if (emptyMessage) emptyMessage.hidden = currentTriggers.length !== 0;
  };

  const showPhoto = (index: number) => {
    if (!dialog || !image || !title || !caption || !eventName || !date || !position || currentTriggers.length === 0) return;
    currentIndex = (index + currentTriggers.length) % currentTriggers.length;
    const trigger = currentTriggers[currentIndex];
    image.src = trigger.dataset.fullSrc ?? "";
    image.alt = trigger.dataset.alt ?? "";
    title.textContent = trigger.dataset.title ?? "";
    caption.textContent = trigger.dataset.caption ?? "";
    eventName.textContent = trigger.dataset.event ?? "";
    date.textContent = trigger.dataset.date ? ` · ${trigger.dataset.date}` : "";
    position.textContent = `${currentIndex + 1} / ${currentTriggers.length}`;
  };

  grid?.addEventListener("click", (event) => {
    if (!dialog) return;
    const trigger = event.target instanceof Element ? event.target.closest<HTMLButtonElement>("[data-gallery-index]") : null;
    if (!trigger) return;
    const index = currentTriggers.indexOf(trigger);
    if (index === -1) return;
    opener = trigger;
    showPhoto(index);
    dialog.showModal();
  });

  filterButtons.forEach((button) => button.addEventListener("click", () => {
    activeEvent = button.dataset.galleryFilter === "all" ? null : button.dataset.galleryFilter ?? null;
    refreshFilter();
    if (dialog?.open) dialog.close();
  }));

  dialog?.querySelector("[data-lightbox-close]")?.addEventListener("click", () => dialog.close());
  dialog?.querySelector("[data-lightbox-prev]")?.addEventListener("click", () => showPhoto(currentIndex - 1));
  dialog?.querySelector("[data-lightbox-next]")?.addEventListener("click", () => showPhoto(currentIndex + 1));
  dialog?.addEventListener("click", (event) => { if (event.target === dialog) dialog.close(); });
  dialog?.addEventListener("close", () => opener?.focus());
  dialog?.addEventListener("keydown", (event) => {
    if (event.key === "Escape") { event.preventDefault(); dialog.close(); }
    if (event.key === "ArrowLeft") { event.preventDefault(); showPhoto(currentIndex - 1); }
    if (event.key === "ArrowRight") { event.preventDefault(); showPhoto(currentIndex + 1); }
  });

  refreshFilter();
</script>

<style>
  .gallery-section { overflow: clip; }
  .gallery-intro { display: grid; gap: 1.5rem 4rem; border-bottom: 1px solid hsl(var(--border)); padding-bottom: 2rem; }
  .gallery-intro-copy { max-width: 38rem; color: hsl(var(--muted-foreground)); }
  .gallery-count { display: flex; align-items: center; gap: .45rem; margin-top: 1rem; color: hsl(var(--foreground)); font-size: .78rem; font-weight: 720; letter-spacing: .02em; }
  .gallery-filters { display: grid; gap: .85rem 1.5rem; align-items: end; margin-top: 2.5rem; border-block: 1px solid hsl(var(--border)); padding-block: 1.25rem; }
  .gallery-filters-title { margin: 0; color: #9f3028; font-size: .7rem; font-weight: 780; letter-spacing: .14em; text-transform: uppercase; }
  .gallery-filter-buttons { display: flex; flex-wrap: wrap; gap: .5rem; }
  .gallery-filter-button { display: inline-flex; min-height: 2.5rem; align-items: center; gap: .5rem; border: 1px solid hsl(var(--border)); border-radius: 2px; padding: .45rem .8rem; background: hsl(var(--card)); color: hsl(var(--foreground)); font-size: .8rem; font-weight: 680; cursor: pointer; }
  .gallery-filter-button:hover, .gallery-filter-button:focus-visible { border-color: hsl(var(--ring)); }
  .gallery-filter-button.is-active { border-color: hsl(var(--primary)); background: hsl(var(--primary)); color: hsl(var(--primary-foreground)); }
  .gallery-filter-count { display: inline-grid; min-width: 1.55rem; height: 1.55rem; place-items: center; border-radius: 999px; background: hsl(var(--muted)); color: hsl(var(--muted-foreground)); font-size: .68rem; font-weight: 760; }
  .gallery-filter-button.is-active .gallery-filter-count { background: rgb(247 248 243 / .18); color: inherit; }
  .gallery-result-count { margin: 0; color: hsl(var(--muted-foreground)); font-size: .78rem; font-weight: 650; }
  .gallery-empty { margin: .35rem 0 0; color: #9f3028; font-size: .85rem; font-weight: 680; }
  .gallery-masonry { margin-top: 2rem; column-count: 1; column-gap: 1.25rem; }
  .gallery-item { display: inline-block; width: 100%; margin: 0 0 1.25rem; break-inside: avoid; border: 1px solid hsl(var(--border)); background: hsl(var(--card)); }
  .gallery-trigger { position: relative; display: block; width: 100%; overflow: hidden; border: 0; padding: 0; background: hsl(var(--muted)); color: inherit; cursor: zoom-in; text-align: left; }
  .gallery-trigger::after { position: absolute; inset: 0; border: 0 solid #b64035; content: ""; transition: border-width .18s ease; pointer-events: none; }
  .gallery-trigger:hover::after, .gallery-trigger:focus-visible::after { border-width: 5px; }
  .gallery-photo { display: block; width: 100%; height: auto; }
  .gallery-view { position: absolute; right: .75rem; bottom: .75rem; display: inline-flex; align-items: center; gap: .4rem; padding: .45rem .65rem; background: rgb(23 27 25 / .9); color: #f7f8f3; font-size: .7rem; font-weight: 720; letter-spacing: .04em; }
  .gallery-item figcaption { padding: .9rem 1rem 1rem; }
  .gallery-item figcaption p { color: #9f3028; font-size: .65rem; font-weight: 760; letter-spacing: .1em; text-transform: uppercase; }
  .gallery-item figcaption h3 { margin-top: .18rem; font-family: var(--font-serif); font-size: 1.15rem; font-weight: 650; line-height: 1.2; }
  .gallery-contribute { display: grid; align-items: center; gap: 1.5rem 3rem; margin-top: 4rem; border-top: 5px solid hsl(var(--primary)); padding: 2rem; background: hsl(var(--card)); }
  .gallery-contribute h2 { font-family: var(--font-serif); font-size: clamp(1.75rem, 4vw, 2.4rem); font-weight: 650; line-height: 1; }
  .gallery-contribute > p { max-width: 38rem; color: hsl(var(--muted-foreground)); }
  .gallery-contribute .button { justify-self: start; white-space: nowrap; }

  .gallery-lightbox { box-sizing: border-box; width: min(94vw, 88rem); max-width: none; height: min(92dvh, 60rem); max-height: calc(100dvh - 2rem); overflow: hidden; margin: 1rem auto; border: 1px solid rgb(255 255 255 / .2); padding: 0; background: #171b19; color: #f7f8f3; }
  .gallery-lightbox::backdrop { background: rgb(8 11 10 / .9); backdrop-filter: blur(5px); }
  .lightbox-frame { position: relative; display: grid; min-height: 0; height: 100%; place-items: center; }
  .lightbox-close, .lightbox-nav { position: absolute; z-index: 2; display: grid; place-items: center; border: 1px solid rgb(255 255 255 / .26); background: rgb(23 27 25 / .88); color: #fff; cursor: pointer; }
  .lightbox-close:hover, .lightbox-nav:hover { background: #b64035; }
  .lightbox-close { top: .75rem; right: .75rem; width: 2.75rem; height: 2.75rem; }
  .lightbox-nav { top: 42%; width: 3rem; height: 3.5rem; }
  .lightbox-prev { left: .75rem; }
  .lightbox-next { right: .75rem; }
  .lightbox-figure { display: grid; min-height: 0; width: 100%; height: 100%; grid-template-rows: minmax(0, 1fr) auto; }
  .lightbox-image-wrap { display: grid; min-height: 0; overflow: hidden; place-items: center; padding: 3.75rem 3.25rem 1rem; }
  .lightbox-image-wrap img { display: block; width: auto; max-width: 100%; height: auto; max-height: min(calc(100dvh - 14rem), 48rem); object-fit: contain; }
  .lightbox-figure figcaption { border-top: 1px solid rgb(255 255 255 / .14); padding: 1.1rem 1.25rem 1.25rem; }
  .lightbox-kicker { display: flex; flex-wrap: wrap; gap: 0; color: #e8c473; font-size: .65rem; font-weight: 760; letter-spacing: .1em; text-transform: uppercase; }
  .lightbox-kicker [data-lightbox-position] { margin-left: auto; color: rgb(247 248 243 / .6); }
  .lightbox-figure h2 { margin-top: .3rem; font-family: var(--font-serif); font-size: clamp(1.45rem, 4vw, 2rem); font-weight: 650; line-height: 1; }
  .lightbox-figure figcaption > p { max-width: 48rem; margin-top: .45rem; color: rgb(247 248 243 / .68); font-size: .85rem; line-height: 1.55; }

  @media (min-width: 640px) {
    .gallery-masonry { column-count: 2; }
  }
  @media (min-width: 768px) {
    .gallery-intro { grid-template-columns: minmax(0, 1fr) minmax(20rem, .72fr); align-items: end; }
    .gallery-filters { grid-template-columns: auto minmax(0, 1fr); }
    .gallery-filters-title { margin-top: .4rem; }
    .gallery-result-count, .gallery-empty { grid-column: 2; }
    .gallery-contribute { grid-template-columns: minmax(18rem, .85fr) minmax(20rem, 1fr) auto; }
    .lightbox-figure figcaption { padding-inline: 4.5rem; }
  }
  @media (min-width: 1100px) {
    .gallery-masonry { column-count: 3; column-gap: 1.5rem; }
    .gallery-item { margin-bottom: 1.5rem; }
  }
  @media (max-width: 639px) {
    .gallery-lightbox { width: 100vw; height: calc(100dvh - 1rem); max-height: calc(100dvh - 1rem); margin: .5rem auto; border: 0; }
    .lightbox-nav { top: 38%; width: 2.75rem; height: 3.25rem; }
    .lightbox-prev { left: .35rem; }
    .lightbox-next { right: .35rem; }
    .lightbox-image-wrap { padding: 3.75rem .5rem .75rem; }
    .gallery-contribute { padding: 1.5rem; }
  }
</style>
