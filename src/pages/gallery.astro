---
import { getCollection } from "astro:content";
import { getImage, Image } from "astro:assets";
import { ChevronLeft, ChevronRight, Expand, Images, X } from "@lucide/astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import { galleryImages } from "../lib/images";
import heroImage from "../assets/images/bgoption.webp";
import { siteConfig } from "../site-config";

const entries = (await getCollection("gallery")).sort((a, b) => a.data.order - b.data.order);
const photos = await Promise.all(entries.map(async (entry, index) => {
  const image = galleryImages[entry.data.imageKey];
  if (!image) throw new Error(`Missing gallery image: ${entry.data.imageKey}`);
  const expanded = await getImage({ src: image, width: Math.min(image.width, 1800), format: "webp", quality: 88 });
  return { ...entry.data, id: entry.id, image, expandedSrc: expanded.src, position: index + 1 };
}));
---

<BaseLayout title={`Gallery | ${siteConfig.name}`} description="Photographs of worship, fellowship, baptisms, cultural celebrations, and church life at First Naga Baptist Church.">
  <PageHero eyebrow="Photo Gallery" title="Church Life, Remembered" description="A growing collection of worship, fellowship, milestones, and shared moments from our church family." image={heroImage} imageAlt="First Naga Baptist Church family gathered together" />

  <main class="gallery-section section" aria-labelledby="gallery-title">
    <div class="site-container">
      <header class="gallery-intro">
        <div>
          <p class="eyebrow">Our Shared Story</p>
          <h2 id="gallery-title" class="section-title">Moments from Our Church Family</h2>
        </div>
        <div class="gallery-intro-copy">
          <p>These photographs preserve the people and moments that shape our life together. Select any image to view it in full.</p>
          <p class="gallery-count"><Images class="size-4" aria-hidden="true" />{photos.length} photographs in this collection</p>
        </div>
      </header>

      <div class="gallery-masonry" aria-label="Church photo gallery">
        {photos.map((photo, index) => (
          <figure class="gallery-item">
            <button
              type="button"
              class="gallery-trigger"
              data-gallery-index={index}
              data-full-src={photo.expandedSrc}
              data-alt={photo.alt}
              data-title={photo.title}
              data-caption={photo.caption}
              data-category={photo.category}
              data-date={photo.dateLabel ?? ""}
              aria-label={`View ${photo.title} in full`}
            >
              <Image src={photo.image} alt={photo.alt} widths={[360, 540, 720]} sizes="(min-width: 1100px) 28vw, (min-width: 640px) 44vw, 100vw" loading={index < 2 ? "eager" : "lazy"} class="gallery-photo" />
              <span class="gallery-view"><Expand class="size-4" aria-hidden="true" />View photo</span>
            </button>
            <figcaption>
              <p>{photo.category}{photo.dateLabel && <><span aria-hidden="true"> · </span>{photo.dateLabel}</>}</p>
              <h3>{photo.title}</h3>
            </figcaption>
          </figure>
        ))}
      </div>

      <aside class="gallery-contribute" aria-labelledby="share-photos-title">
        <div><p class="eyebrow">Help Preserve Our Story</p><h2 id="share-photos-title">Have church photos to share?</h2></div>
        <p>Send original photographs with the event name and approximate date so they can be considered for the gallery.</p>
        <a class="button" href={`mailto:${siteConfig.email}?subject=Church%20gallery%20photos`}>Share Photos</a>
      </aside>
    </div>
  </main>

  <dialog id="gallery-lightbox" class="gallery-lightbox" aria-labelledby="lightbox-title">
    <div class="lightbox-frame">
      <button type="button" class="lightbox-close" data-lightbox-close aria-label="Close expanded photo"><X class="size-6" aria-hidden="true" /></button>
      <button type="button" class="lightbox-nav lightbox-prev" data-lightbox-prev aria-label="View previous photo"><ChevronLeft class="size-7" aria-hidden="true" /></button>
      <figure class="lightbox-figure">
        <div class="lightbox-image-wrap"><img data-lightbox-image src="" alt="" /></div>
        <figcaption>
          <div class="lightbox-kicker"><span data-lightbox-category></span><span data-lightbox-date></span><span data-lightbox-position></span></div>
          <h2 id="lightbox-title" data-lightbox-title></h2>
          <p data-lightbox-caption></p>
        </figcaption>
      </figure>
      <button type="button" class="lightbox-nav lightbox-next" data-lightbox-next aria-label="View next photo"><ChevronRight class="size-7" aria-hidden="true" /></button>
    </div>
  </dialog>
</BaseLayout>

<script>
  const dialog = document.querySelector<HTMLDialogElement>("#gallery-lightbox");
  const triggers = [...document.querySelectorAll<HTMLButtonElement>("[data-gallery-index]")];
  const image = dialog?.querySelector<HTMLImageElement>("[data-lightbox-image]");
  const title = dialog?.querySelector<HTMLElement>("[data-lightbox-title]");
  const caption = dialog?.querySelector<HTMLElement>("[data-lightbox-caption]");
  const category = dialog?.querySelector<HTMLElement>("[data-lightbox-category]");
  const date = dialog?.querySelector<HTMLElement>("[data-lightbox-date]");
  const position = dialog?.querySelector<HTMLElement>("[data-lightbox-position]");
  let currentIndex = 0;
  let opener: HTMLButtonElement | undefined;

  const showPhoto = (index: number) => {
    if (!dialog || !image || !title || !caption || !category || !date || !position || triggers.length === 0) return;
    currentIndex = (index + triggers.length) % triggers.length;
    const trigger = triggers[currentIndex];
    image.src = trigger.dataset.fullSrc ?? "";
    image.alt = trigger.dataset.alt ?? "";
    title.textContent = trigger.dataset.title ?? "";
    caption.textContent = trigger.dataset.caption ?? "";
    category.textContent = trigger.dataset.category ?? "";
    date.textContent = trigger.dataset.date ? ` · ${trigger.dataset.date}` : "";
    position.textContent = `${currentIndex + 1} / ${triggers.length}`;
  };

  triggers.forEach((trigger, index) => trigger.addEventListener("click", () => {
    if (!dialog) return;
    opener = trigger;
    showPhoto(index);
    dialog.showModal();
  }));

  dialog?.querySelector("[data-lightbox-close]")?.addEventListener("click", () => dialog.close());
  dialog?.querySelector("[data-lightbox-prev]")?.addEventListener("click", () => showPhoto(currentIndex - 1));
  dialog?.querySelector("[data-lightbox-next]")?.addEventListener("click", () => showPhoto(currentIndex + 1));
  dialog?.addEventListener("click", (event) => { if (event.target === dialog) dialog.close(); });
  dialog?.addEventListener("close", () => opener?.focus());
  dialog?.addEventListener("keydown", (event) => {
    if (event.key === "Escape") { event.preventDefault(); dialog.close(); }
    if (event.key === "ArrowLeft") { event.preventDefault(); showPhoto(currentIndex - 1); }
    if (event.key === "ArrowRight") { event.preventDefault(); showPhoto(currentIndex + 1); }
  });
</script>

<style>
  .gallery-section { overflow: clip; }
  .gallery-intro { display: grid; gap: 1.5rem 4rem; border-bottom: 1px solid hsl(var(--border)); padding-bottom: 2rem; }
  .gallery-intro-copy { max-width: 38rem; color: hsl(var(--muted-foreground)); }
  .gallery-count { display: flex; align-items: center; gap: .45rem; margin-top: 1rem; color: hsl(var(--foreground)); font-size: .78rem; font-weight: 720; letter-spacing: .02em; }
  .gallery-masonry { margin-top: 2.5rem; column-count: 1; column-gap: 1.25rem; }
  .gallery-item { display: inline-block; width: 100%; margin: 0 0 1.25rem; break-inside: avoid; border: 1px solid hsl(var(--border)); background: hsl(var(--card)); }
  .gallery-trigger { position: relative; display: block; width: 100%; overflow: hidden; border: 0; padding: 0; background: hsl(var(--muted)); color: inherit; cursor: zoom-in; text-align: left; }
  .gallery-trigger::after { position: absolute; inset: 0; border: 0 solid #b64035; content: ""; transition: border-width .18s ease; pointer-events: none; }
  .gallery-trigger:hover::after, .gallery-trigger:focus-visible::after { border-width: 5px; }
  .gallery-photo { display: block; width: 100%; height: auto; }
  .gallery-view { position: absolute; right: .75rem; bottom: .75rem; display: inline-flex; align-items: center; gap: .4rem; padding: .45rem .65rem; background: rgb(23 27 25 / .9); color: #f7f8f3; font-size: .7rem; font-weight: 720; letter-spacing: .04em; }
  .gallery-item figcaption { padding: .9rem 1rem 1rem; }
  .gallery-item figcaption p { color: #9f3028; font-size: .65rem; font-weight: 760; letter-spacing: .1em; text-transform: uppercase; }
  .gallery-item figcaption h3 { margin-top: .18rem; font-family: var(--font-serif); font-size: 1.15rem; font-weight: 650; line-height: 1.2; }
  .gallery-contribute { display: grid; align-items: center; gap: 1.5rem 3rem; margin-top: 4rem; border-top: 5px solid hsl(var(--primary)); padding: 2rem; background: hsl(var(--card)); }
  .gallery-contribute h2 { font-family: var(--font-serif); font-size: clamp(1.75rem, 4vw, 2.4rem); font-weight: 650; line-height: 1; }
  .gallery-contribute > p { max-width: 38rem; color: hsl(var(--muted-foreground)); }
  .gallery-contribute .button { justify-self: start; white-space: nowrap; }

  .gallery-lightbox { box-sizing: border-box; width: min(94vw, 88rem); max-width: none; height: min(92dvh, 60rem); max-height: calc(100dvh - 2rem); overflow: hidden; margin: 1rem auto; border: 1px solid rgb(255 255 255 / .2); padding: 0; background: #171b19; color: #f7f8f3; }
  .gallery-lightbox::backdrop { background: rgb(8 11 10 / .9); backdrop-filter: blur(5px); }
  .lightbox-frame { position: relative; display: grid; min-height: 0; height: 100%; place-items: center; }
  .lightbox-close, .lightbox-nav { position: absolute; z-index: 2; display: grid; place-items: center; border: 1px solid rgb(255 255 255 / .26); background: rgb(23 27 25 / .88); color: #fff; cursor: pointer; }
  .lightbox-close:hover, .lightbox-nav:hover { background: #b64035; }
  .lightbox-close { top: .75rem; right: .75rem; width: 2.75rem; height: 2.75rem; }
  .lightbox-nav { top: 42%; width: 3rem; height: 3.5rem; }
  .lightbox-prev { left: .75rem; }
  .lightbox-next { right: .75rem; }
  .lightbox-figure { display: grid; min-height: 0; width: 100%; height: 100%; grid-template-rows: minmax(0, 1fr) auto; }
  .lightbox-image-wrap { display: grid; min-height: 0; overflow: hidden; place-items: center; padding: 3.75rem 3.25rem 1rem; }
  .lightbox-image-wrap img { display: block; width: auto; max-width: 100%; height: auto; max-height: min(calc(100dvh - 14rem), 48rem); object-fit: contain; }
  .lightbox-figure figcaption { border-top: 1px solid rgb(255 255 255 / .14); padding: 1.1rem 1.25rem 1.25rem; }
  .lightbox-kicker { display: flex; flex-wrap: wrap; gap: 0; color: #e8c473; font-size: .65rem; font-weight: 760; letter-spacing: .1em; text-transform: uppercase; }
  .lightbox-kicker [data-lightbox-position] { margin-left: auto; color: rgb(247 248 243 / .6); }
  .lightbox-figure h2 { margin-top: .3rem; font-family: var(--font-serif); font-size: clamp(1.45rem, 4vw, 2rem); font-weight: 650; line-height: 1; }
  .lightbox-figure figcaption > p { max-width: 48rem; margin-top: .45rem; color: rgb(247 248 243 / .68); font-size: .85rem; line-height: 1.55; }

  @media (min-width: 640px) {
    .gallery-masonry { column-count: 2; }
  }
  @media (min-width: 768px) {
    .gallery-intro { grid-template-columns: minmax(0, 1fr) minmax(20rem, .72fr); align-items: end; }
    .gallery-contribute { grid-template-columns: minmax(18rem, .85fr) minmax(20rem, 1fr) auto; }
    .lightbox-figure figcaption { padding-inline: 4.5rem; }
  }
  @media (min-width: 1100px) {
    .gallery-masonry { column-count: 3; column-gap: 1.5rem; }
    .gallery-item { margin-bottom: 1.5rem; }
  }
  @media (max-width: 639px) {
    .gallery-lightbox { width: 100vw; height: calc(100dvh - 1rem); max-height: calc(100dvh - 1rem); margin: .5rem auto; border: 0; }
    .lightbox-nav { top: 38%; width: 2.75rem; height: 3.25rem; }
    .lightbox-prev { left: .35rem; }
    .lightbox-next { right: .35rem; }
    .lightbox-image-wrap { padding: 3.75rem .5rem .75rem; }
    .gallery-contribute { padding: 1.5rem; }
  }
</style>
