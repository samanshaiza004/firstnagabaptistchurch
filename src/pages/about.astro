---
import { BookOpen, Globe, HandHeart, Link2, Users } from "@lucide/astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import CmsImage from "../components/CmsImage.astro";
import PageHero from "../components/PageHero.astro";
import RichText from "../components/RichText.astro";
import { getCmsContent } from "../lib/cms/content";

const { pages, objectives } = await getCmsContent();
const page = pages.about;
const icons = { book: BookOpen, users: Users, globe: Globe, service: HandHeart, connection: Link2, house: HandHeart, heart: HandHeart };
---

<BaseLayout title={page.seo.title} description={page.seo.description} socialImage={page.seo.socialImage}>
  <PageHero {...page.hero} />

  <section class="section"><div class="site-container"><div class="mx-auto max-w-4xl"><div class="mb-12 text-center"><p class="eyebrow">{page.historyEyebrow}</p><h2 class="section-title">{page.historyTitle}</h2></div>
    <div class="mb-12 grid items-start gap-8 lg:grid-cols-5"><RichText value={page.historyLead} class="space-y-6 leading-relaxed text-muted-foreground lg:col-span-3" /><CmsImage image={page.historyImage} widths={[360, 540, 720]} sizes="(min-width: 1024px) 40vw, 100vw" loading="lazy" class="aspect-[3/4] w-full rounded-lg object-cover shadow-xl lg:col-span-2" /></div>
    <blockquote class="mb-12 rounded-lg border-l-4 border-secondary bg-muted/50 p-6 font-serif text-lg italic leading-relaxed lg:p-8 lg:text-xl">“{page.quote}”<footer class="mt-4 font-sans text-sm not-italic text-muted-foreground">— {page.quoteAttribution}</footer></blockquote>
    <RichText value={page.historyMiddle} class="space-y-6 leading-relaxed text-muted-foreground" />
    <div class="my-12 rounded-lg bg-primary p-6 text-primary-foreground lg:p-8"><div class="mb-4 flex items-center gap-4"><span class="flex size-16 shrink-0 items-center justify-center rounded-full bg-secondary font-serif text-xl font-bold text-secondary-foreground">{page.founding.year}</span><div><h3 class="font-serif text-xl font-semibold">{page.founding.title}</h3><p class="text-primary-foreground/80">{page.founding.date}</p></div></div><p class="leading-relaxed text-primary-foreground/90">{page.founding.body}</p></div>
    <RichText value={page.historyFinal} class="space-y-6 leading-relaxed text-muted-foreground" />
    <div class="mt-12 rounded-lg bg-muted p-6 lg:p-8"><h3 class="mb-4 font-serif text-xl font-semibold">{page.inauguration.title}</h3><p class="mb-4 leading-relaxed text-muted-foreground">{page.inauguration.body}</p><p class="mb-2 text-sm font-semibold">Distinguished Guest Speakers:</p><ul class="grid gap-2 text-sm text-muted-foreground sm:grid-cols-2">{page.inauguration.guestSpeakers.map((speaker) => <li>{speaker}</li>)}</ul></div><p class="mt-8 text-right text-sm italic text-muted-foreground">{page.inauguration.historyDate}</p>
  </div></div></section>

  <section class="section bg-muted"><div class="site-container"><div class="mb-12 text-center"><p class="eyebrow">{page.founders.eyebrow}</p><h2 class="section-title mb-4">{page.founders.title}</h2><p class="section-copy mx-auto">{page.founders.description}</p></div><div class="mx-auto mb-10 max-w-4xl"><CmsImage image={page.founders.image} widths={[640, 960, 1280]} sizes="100vw" loading="lazy" class="h-auto max-h-[32rem] w-full rounded-lg object-cover shadow-lg" /><p class="mt-3 text-center text-sm italic text-muted-foreground">{page.founders.caption}</p></div><h3 class="mb-8 text-center font-serif text-2xl font-bold">Founding Members</h3><ul class="mx-auto grid max-w-5xl gap-4 sm:grid-cols-2 lg:grid-cols-3">{page.founders.names.map((founder) => <li class="card p-5 text-center font-medium">{founder}</li>)}</ul></div></section>

  <section class="section"><div class="site-container"><div class="mb-12 text-center"><p class="eyebrow">{page.objectivesEyebrow}</p><h2 class="section-title mb-4">{page.objectivesTitle}</h2><p class="section-copy mx-auto">{page.objectivesDescription}</p></div><div class="mx-auto max-w-4xl space-y-6">{objectives.map((objective) => { const Icon = icons[objective.icon]; return <article class="flex gap-5 rounded-lg border border-border bg-muted/30 p-6"><span class="flex size-14 shrink-0 items-center justify-center rounded-full bg-primary text-primary-foreground"><Icon class="size-6" /></span><div><h3 class="mb-2 font-serif text-lg font-semibold">{objective.title}</h3><p class="leading-relaxed text-muted-foreground">{objective.description}</p></div></article>; })}</div><div class="mt-12 text-center"><a class="button" href={page.objectivesCta.href}>{page.objectivesCta.label}</a></div></div></section>
</BaseLayout>
