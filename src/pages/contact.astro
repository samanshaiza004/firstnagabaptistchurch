---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCmsContent } from "../lib/cms/content";

const { settings } = await getCmsContent();
---

<BaseLayout title={`Visit | ${settings.name}`} description={`Plan a visit to ${settings.name}.`} noindex redirectTo="/visit">
  <section class="site-container flex min-h-[50vh] items-center justify-center py-20 text-center">
    <div class="max-w-xl">
      <p class="eyebrow">Moved</p>
      <h1 class="mb-4 font-serif text-4xl font-bold md:text-5xl">This page has moved</h1>
      <p class="mb-8 text-muted-foreground">Our contact information and Sunday details now live on the Visit page.</p>
      <a class="button" href="/visit">Go to Visit</a>
    </div>
  </section>
</BaseLayout>
