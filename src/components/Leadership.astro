---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import { ChevronDown, Heart, Music } from "@lucide/astro";
import { personImages } from "../lib/images";

const people = await getCollection("people");
const ministries = (await getCollection("ministries")).sort((a, b) => a.data.order - b.data.order);
const leaders = people.filter((person) => person.data.group === "leadership").sort((a, b) => a.data.order - b.data.order);
const trustees = people.filter((person) => person.data.group === "trustee").sort((a, b) => a.data.order - b.data.order);
const peopleById = new Map(people.map((person) => [person.id, person.data]));
const iconMap = { music: Music, heart: Heart };
---

<section class="section bg-muted/30" aria-labelledby="leadership-title">
  <div class="site-container">
    <div class="section-heading-grid mb-12">
      <div><p class="eyebrow">Our Leadership</p><h2 id="leadership-title" class="section-title">Meet the Team</h2></div>
      <p class="section-copy">Get to know the dedicated servants who guide our church family with faith, wisdom, and love.</p>
    </div>

    <div class="mb-16 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {leaders.map((leader) => (
        <details class="leadership-card card group overflow-hidden">
          <summary class="cursor-pointer list-none [&::-webkit-details-marker]:hidden">
            <div class="aspect-square overflow-hidden bg-muted">
              <Image src={personImages[leader.data.imageKey]} alt={`Portrait of ${leader.data.name}`} widths={[320, 480, 640]} sizes="(min-width: 1024px) 30vw, (min-width: 640px) 45vw, 100vw" loading="lazy" class="size-full object-cover transition-transform duration-300 group-hover:scale-[1.02]" />
            </div>
            <div class="p-5 pb-3">
              <span class="mb-2 inline-flex rounded-full bg-secondary/20 px-2.5 py-1 text-xs text-secondary-foreground">{leader.data.category}</span>
              <h3 class="mb-1 font-serif text-lg font-semibold">{leader.data.name}</h3>
              <p class="text-sm font-medium text-secondary-foreground">{leader.data.role}</p>
              <span class="mt-3 flex items-center gap-1 text-xs text-muted-foreground"><ChevronDown class="size-4 transition-transform group-open:rotate-180" aria-hidden="true" /><span class="closed-label">Read biography</span><span class="open-label hidden">Hide biography</span></span>
            </div>
          </summary>
          <div class="px-5 pb-5"><p class="border-t border-border pt-4 text-sm leading-relaxed text-muted-foreground">{leader.data.bio}</p></div>
        </details>
      ))}
    </div>

    <div class="mb-12 space-y-8">
      {ministries.map((ministry) => {
        const teamLeader = peopleById.get(ministry.data.leaderId);
        const Icon = iconMap[ministry.data.icon];
        if (!teamLeader) throw new Error(`Missing ministry leader: ${ministry.data.leaderId}`);
        return (
          <article class="card rounded-2xl p-6 md:p-8">
            <div class="mb-8 flex flex-col gap-6 md:flex-row md:items-center">
              <div class="flex items-center gap-4 md:min-w-72">
                <Image src={personImages[teamLeader.imageKey]} alt={`Portrait of ${teamLeader.name}`} width={96} height={96} loading="lazy" class="size-20 shrink-0 rounded-full border-4 border-secondary/20 object-cover shadow-md md:size-24" />
                <div><span class="mb-1 inline-flex items-center gap-1 rounded-full bg-secondary/15 px-2 py-1 text-xs text-secondary-foreground"><Icon class="size-3" aria-hidden="true" />Leader</span><h3 class="font-serif text-lg font-semibold">{teamLeader.name}</h3><p class="text-sm text-muted-foreground">{teamLeader.role}</p></div>
              </div>
              <div class="h-px bg-border md:h-16 md:w-px"></div>
              <div><div class="mb-1 flex items-center gap-2"><Icon class="size-5 text-secondary-foreground" aria-hidden="true" /><h3 class="font-serif text-xl font-bold md:text-2xl">{ministry.data.name}</h3></div><p class="text-sm text-muted-foreground">{ministry.data.members.length} dedicated team members</p></div>
            </div>
            <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
              {ministry.data.members.map((member) => <li class="rounded-xl border border-border/60 bg-muted/50 p-4 text-center"><span class="mx-auto mb-3 flex size-12 items-center justify-center rounded-full bg-secondary/15"><Icon class="size-6 text-secondary-foreground" aria-hidden="true" /></span><span class="block font-medium">{member}</span><span class="mt-1 block text-xs text-muted-foreground">Team Member</span></li>)}
            </ul>
          </article>
        );
      })}
    </div>

    <div class="rounded-xl bg-primary/5 p-6 md:p-8">
      <h3 class="mb-2 font-serif text-xl font-semibold">Board of Trustees</h3>
      <p class="mb-6 max-w-2xl text-sm text-muted-foreground">Our trustees oversee the church's budget and financial matters. As pioneers and elders, they provide invaluable guidance for our future goals and vision.</p>
      <div class="mx-auto max-w-4xl space-y-4">
        {trustees.map((trustee) => (
          <article class="card flex overflow-hidden">
            <Image src={personImages[trustee.data.imageKey]} alt={`Portrait of ${trustee.data.name}`} width={192} height={192} loading="lazy" class="w-28 shrink-0 object-cover sm:w-36" />
            <div class="p-5"><span class="mb-2 inline-flex rounded-full bg-secondary/20 px-2.5 py-1 text-xs">Trustee</span><h4 class="mb-1 font-serif text-lg font-semibold">{trustee.data.name}</h4><p class="text-sm leading-relaxed text-muted-foreground sm:text-base">{trustee.data.bio}</p></div>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  details[open] .closed-label { display: none; }
  details[open] .open-label { display: inline; }
</style>

<script>
  const cards = [...document.querySelectorAll<HTMLDetailsElement>(".leadership-card")];
  const query = window.matchMedia("(max-width: 767px)");
  const setMobileState = (event: MediaQueryList | MediaQueryListEvent) => cards.forEach((card) => { card.open = event.matches; });
  setMobileState(query);
  query.addEventListener("change", setMobileState);
</script>
