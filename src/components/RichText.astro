---
import type { PortableBlock } from "../lib/cms/types";
import PortableSpan from "./PortableSpan.astro";
interface Props { value: PortableBlock[]; class?: string }
const { value, class: className } = Astro.props;
type Node = { type: "block"; block: PortableBlock } | { type: "list"; style: "bullet" | "number"; blocks: PortableBlock[] };
const nodes: Node[] = [];
for (const block of value) {
  if (!block.listItem) { nodes.push({ type: "block", block }); continue; }
  const previous = nodes.at(-1);
  if (previous?.type === "list" && previous.style === block.listItem) previous.blocks.push(block);
  else nodes.push({ type: "list", style: block.listItem, blocks: [block] });
}
---
<div class:list={["cms-rich-text", className]}>
  {nodes.map((node) => node.type === "list" ? (
    node.style === "number"
      ? <ol>{node.blocks.map((block) => <li>{block.children.map((span) => <PortableSpan span={span} markDefs={block.markDefs} />)}</li>)}</ol>
      : <ul>{node.blocks.map((block) => <li>{block.children.map((span) => <PortableSpan span={span} markDefs={block.markDefs} />)}</li>)}</ul>
  ) : node.block.style === "h3"
    ? <h3>{node.block.children.map((span) => <PortableSpan span={span} markDefs={node.block.markDefs} />)}</h3>
    : <p>{node.block.children.map((span) => <PortableSpan span={span} markDefs={node.block.markDefs} />)}</p>)}
</div>

<style>
  .cms-rich-text :global(p + p),
  .cms-rich-text :global(p + ul),
  .cms-rich-text :global(p + ol),
  .cms-rich-text :global(ul + p),
  .cms-rich-text :global(ol + p) { margin-top: 1rem; }
  .cms-rich-text :global(h3) { margin-top: 1.75rem; font-family: var(--font-serif); font-size: 1.25rem; font-weight: 700; }
  .cms-rich-text :global(ul), .cms-rich-text :global(ol) { padding-left: 1.5rem; }
  .cms-rich-text :global(ul) { list-style: disc; }
  .cms-rich-text :global(ol) { list-style: decimal; }
  .cms-rich-text :global(a) { text-decoration: underline; text-underline-offset: 0.2em; }
</style>
