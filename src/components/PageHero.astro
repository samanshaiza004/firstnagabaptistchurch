---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  eyebrow: string;
  title: string;
  description: string;
  image: ImageMetadata;
  imageAlt: string;
}

const { eyebrow, title, description, image, imageAlt } = Astro.props;
---

<section class="page-hero">
  <div class="page-hero-grid">
    <div class="page-hero-copy">
      <p class="eyebrow">{eyebrow}</p>
      <h1 class="text-balance">{title}</h1>
      <p class="mt-6 text-lg leading-relaxed md:text-xl">{description}</p>
    </div>
    <div class="page-hero-media">
      <Image src={image} alt={imageAlt} widths={[640, 960, 1280, 1600]} sizes="(min-width: 768px) 58vw, 100vw" loading="eager" fetchpriority="high" class="size-full object-cover" />
    </div>
    <div class="page-hero-seam woven-band" aria-hidden="true"></div>
  </div>
</section>
