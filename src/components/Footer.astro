---
import { ArrowUpRight, Clock, Mail, MapPin, Phone } from "@lucide/astro";
import { socialLinks } from "../site-config";
import type { SiteSettings } from "../lib/cms/types";

interface Props { settings: SiteSettings }
const { settings } = Astro.props;

const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(`${settings.venue}, ${settings.address}`)}`;
const explore = [
  { name: "About", href: "/about" },
  { name: "Leadership", href: "/leadership" },
  { name: "Scholarship", href: "/scholarship" },
  { name: "Events", href: "/events" },
  { name: "Gallery", href: "/gallery" },
  { name: "Give", href: "/give" },
];
---

<footer class="site-footer relative bg-indigo text-cotton">
  <hr class="band-major on-dark" aria-hidden="true" />
  <div class="site-container py-12 lg:py-16">
    <div class="footer-grid pt-6">
      <div>
        <div class="mb-4 flex items-center gap-3">
          <span class="brand-mark" aria-hidden="true">FNBC</span>
          <div>
            <p class="font-serif text-lg font-semibold">{settings.name}</p>
            <p class="text-sm text-cotton/70">{settings.region}</p>
          </div>
        </div>
        <p class="max-w-md text-sm leading-relaxed text-cotton/80">{settings.footerDescription}</p>
      </div>

      <div>
        <h2 class="mb-4 font-serif text-lg font-semibold">Plan a Visit</h2>
        <ul class="space-y-3">
          <li class="flex items-start gap-3">
            <Clock class="mt-1 size-4 shrink-0 text-cotton/70" aria-hidden="true" />
            <span class="text-sm text-cotton/80">Sundays at <span data-service-time>{settings.serviceTime.standard} standard / {settings.serviceTime.daylight} daylight time</span></span>
          </li>
          <li class="flex items-start gap-3">
            <MapPin class="mt-1 size-4 shrink-0 text-cotton/70" aria-hidden="true" />
            <span class="text-sm text-cotton/80">{settings.venue}<br />{settings.address}<br />
              <a href={directionsUrl} target="_blank" rel="noopener" class="font-medium text-cotton underline underline-offset-2 hover:text-white">Get directions</a>
            </span>
          </li>
        </ul>
      </div>

      <div>
        <h2 class="mb-4 font-serif text-lg font-semibold">Explore</h2>
        <ul class="footer-links">
          {explore.map((link) => <li><a href={link.href} class="text-sm text-cotton/80 transition-colors hover:text-white">{link.name}</a></li>)}
        </ul>
      </div>
      <div>
        <h2 class="mb-4 font-serif text-lg font-semibold">Contact</h2>
        <ul class="space-y-3">
          <li class="flex items-start gap-3"><Mail class="mt-1 size-4 shrink-0 text-cotton/70" aria-hidden="true" /><a href={`mailto:${settings.email}`} class="break-all text-sm text-cotton/80 hover:text-white">{settings.email}</a></li>
          <li class="flex items-center gap-3"><Phone class="size-4 shrink-0 text-cotton/70" aria-hidden="true" /><a href={`tel:${settings.phoneHref}`} class="text-sm text-cotton/80 hover:text-white">{settings.phoneDisplay}</a></li>
        </ul>
        <h2 class="mb-3 mt-8 font-serif text-lg font-semibold">Follow along</h2>
        <div class="flex flex-wrap gap-2">
          {socialLinks.map((link) => (
            <a href={link.href} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 border border-cotton/25 px-3 py-2 text-sm font-medium text-cotton/85 transition-colors hover:border-cotton hover:bg-cotton/10 hover:text-white">
              {link.name}<ArrowUpRight class="size-3.5" aria-hidden="true" />
            </a>
          ))}
        </div>
      </div>
    </div>
    <div class="mt-12 border-t border-cotton/20 pt-8"><p class="text-center text-sm text-cotton/60">&copy; {new Date().getFullYear()} {settings.name}. All rights reserved.</p></div>
  </div>
</footer>
