{
  "name": "firstnagabaptistchurch",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "dev:netlify": "netlify dev",
    "check": "astro check",
    "check:studio": "tsc --noEmit -p ../studio-first-naga-baptist-church-website/tsconfig.json",
    "build": "astro check && astro build",
    "lint": "eslint .",
    "test": "bun test",
    "preview": "astro preview",
    "studio:dev": "bun run --cwd ../studio-first-naga-baptist-church-website dev",
    "studio:build": "bun run --cwd ../studio-first-naga-baptist-church-website build",
    "studio:deploy": "bun run --cwd ../studio-first-naga-baptist-church-website deploy",
    "cms:migrate": "bun run scripts/cms/migrate.ts",
    "cms:export": "bun run scripts/cms/export.ts"
  },
  "dependencies": {
    "@astrojs/sitemap": "latest",
    "@fontsource-variable/alegreya": "latest",
    "@fontsource-variable/public-sans": "latest",
    "@lucide/astro": "latest",
    "@netlify/functions": "^5.1.2",
    "@sanity/astro": "^3.4.2",
    "@sanity/client": "^7.11.2",
    "astro": "^7.0.0",
    "nodemailer": "^7.0.12",
    "sharp": "latest"
  },
  "devDependencies": {
    "@astrojs/check": "latest",
    "@eslint/js": "^9.39.1",
    "@tailwindcss/vite": "latest",
    "@types/bun": "latest",
    "@types/node": "^24.10.1",
    "@types/nodemailer": "^7.0.4",
    "astro-eslint-parser": "latest",
    "eslint": "^9.39.1",
    "eslint-plugin-astro": "latest",
    "globals": "^16.5.0",
    "netlify-cli": "latest",
    "tailwindcss": "^4.0.0",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.46.4"
  },
  "overrides": {
    "eventemitter3": "^5.0.4"
  }
}
